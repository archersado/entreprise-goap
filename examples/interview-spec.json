{
  "id": "order-approval",
  "version": 3,
  "title": "订单审批",
  "summary": "收集订单资料并完成审批",
  "objective": "形成可以执行的已审批订单",
  "actors": [
    { "id": "sales", "name": "销售 Agent", "responsibilities": ["收集订单资料"] },
    { "id": "manager", "name": "审批 Agent", "responsibilities": ["核对并批准订单"] }
  ],
  "states": [
    { "id": "order_complete", "description": "订单资料完整", "observable": true, "evidenceRequired": "订单字段校验报告" },
    { "id": "order_incomplete", "description": "订单资料存在缺项", "observable": true, "evidenceRequired": "缺失字段清单" },
    { "id": "order_rejected", "description": "订单被经理驳回", "observable": true, "evidenceRequired": "驳回记录" },
    { "id": "order_approved", "description": "订单已经批准", "observable": true, "evidenceRequired": "审批记录" },
    { "id": "approval_withdrawn", "description": "审批已经撤回", "observable": true, "evidenceRequired": "撤回记录" },
    { "id": "order_data_removed", "description": "订单资料已经清除", "observable": true, "evidenceRequired": "数据清除审计记录" }
  ],
  "actions": [
    {
      "id": "collect_order",
      "name": "收集订单",
      "description": "补全并校验订单资料",
      "ownerRole": "sales",
      "preconditions": [],
      "effects": ["order_complete"],
      "removes": ["order_incomplete"],
      "executor": "demo:semantic-action",
      "evidenceType": "order_validation",
      "failureHandling": "缺失字段时回到销售补充",
      "failureModes": [{
        "id": "missing_fields",
        "trigger": "BUSINESS_RULE",
        "description": "必填字段缺失，无法形成完整订单",
        "effects": ["order_incomplete"],
        "recoveryActionId": "complete_missing_order",
        "terminal": false,
        "evidenceType": "missing_field_report"
      }],
      "noKnownFailureRationale": "",
      "reversibility": "COMPENSATABLE",
      "reverseActionId": "delete_order_data",
      "cost": 1.0,
      "idempotent": true
    },
    {
      "id": "approve_order",
      "name": "审批订单",
      "description": "经理核对订单并做出审批决定",
      "ownerRole": "manager",
      "preconditions": ["order_complete"],
      "effects": ["order_approved"],
      "removes": ["order_rejected", "approval_withdrawn"],
      "executor": "demo:semantic-action",
      "evidenceType": "approval_record",
      "failureHandling": "拒绝时记录原因并返回销售",
      "failureModes": [{
        "id": "manager_rejection",
        "trigger": "REJECTION",
        "description": "经理发现业务条件不满足并驳回订单",
        "effects": ["order_rejected"],
        "recoveryActionId": "revise_rejected_order",
        "terminal": false,
        "evidenceType": "rejection_record"
      }],
      "noKnownFailureRationale": "",
      "reversibility": "REVERSIBLE",
      "reverseActionId": "withdraw_approval",
      "cost": 1.0,
      "idempotent": true
    },
    {
      "id": "complete_missing_order",
      "name": "补全缺失订单资料",
      "description": "根据缺失字段清单补齐订单",
      "ownerRole": "sales",
      "preconditions": ["order_incomplete"],
      "effects": ["order_complete"],
      "removes": ["order_incomplete"],
      "executor": "demo:semantic-action",
      "evidenceType": "order_validation",
      "failureHandling": "本演示将再次失败视为新的缺失字段事件",
      "failureModes": [],
      "noKnownFailureRationale": "确定性演示执行器不会产生第二类异常。",
      "reversibility": "IRREVERSIBLE",
      "reverseActionId": null,
      "cost": 1.0,
      "idempotent": true
    },
    {
      "id": "revise_rejected_order",
      "name": "修订被驳回订单",
      "description": "根据驳回原因修订订单并重新形成完整资料",
      "ownerRole": "sales",
      "preconditions": ["order_rejected"],
      "effects": ["order_complete"],
      "removes": ["order_rejected"],
      "executor": "demo:semantic-action",
      "evidenceType": "revision_record",
      "failureHandling": "本演示将再次驳回交由新的审批事件处理",
      "failureModes": [],
      "noKnownFailureRationale": "确定性演示执行器不会产生第二类异常。",
      "reversibility": "IRREVERSIBLE",
      "reverseActionId": null,
      "cost": 1.0,
      "idempotent": true
    },
    {
      "id": "withdraw_approval",
      "name": "撤回审批",
      "description": "撤销已批准状态并留下撤回记录",
      "ownerRole": "manager",
      "preconditions": ["order_approved"],
      "effects": ["approval_withdrawn"],
      "removes": ["order_approved"],
      "executor": "demo:semantic-action",
      "evidenceType": "withdrawal_record",
      "failureHandling": "演示执行器不模拟撤回失败",
      "failureModes": [],
      "noKnownFailureRationale": "确定性演示执行器总能撤回本地审批事实。",
      "reversibility": "IRREVERSIBLE",
      "reverseActionId": null,
      "cost": 1.0,
      "idempotent": true
    },
    {
      "id": "delete_order_data",
      "name": "清除订单资料",
      "description": "作为收集订单的业务补偿，清除已保存资料",
      "ownerRole": "sales",
      "preconditions": ["order_complete"],
      "effects": ["order_data_removed"],
      "removes": ["order_complete"],
      "executor": "demo:semantic-action",
      "evidenceType": "data_deletion_record",
      "failureHandling": "演示执行器不模拟清除失败",
      "failureModes": [],
      "noKnownFailureRationale": "确定性演示执行器总能清除本地订单事实。",
      "reversibility": "IRREVERSIBLE",
      "reverseActionId": null,
      "cost": 1.0,
      "idempotent": true
    }
  ],
  "goals": [
    { "id": "order_ready", "description": "订单可执行", "satisfiedBy": ["order_approved"], "value": 1.0 }
  ],
  "policies": [
    { "id": "approval_gate", "description": "资料完整才能审批", "expression": "order_complete -> approve_order" }
  ],
  "assumptions": [],
  "openQuestions": [],
  "confirmedClaims": ["订单资料完整后才能审批"],
  "rejectedClaims": [],
  "status": "CONFIRMED"
}
